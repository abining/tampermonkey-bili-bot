{
  "name": "tampermonkey-bili-bot",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "build": "pnpm run build:prod",
    "build:dev": "vite build --mode development",
    "build:prod": "vite build --mode prod",
    "preview": "vite preview --mode prod",
    "serve:userscript": "python3 scripts/serve_userscript.py dist/bilibili-video-summary-beta.user.js",
    "test:userscript:dev": "pnpm run build:dev && node scripts/verify-userscript-env.mjs development",
    "test:userscript:prod": "pnpm run build:prod && node scripts/verify-userscript-env.mjs prod",
    "test:userscript": "pnpm run test:userscript:dev && pnpm run test:userscript:prod",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "lucide-react": "^1.33.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vite-plugin-monkey": "^8.0.0"
  }
}
